{
  "listen": "127.0.0.1:8443",
  "tls": {
    "cert_file": "/etc/rixa/tls/dev.crt",
    "key_file": "/etc/rixa/tls/dev.key"
  },
  "language": "en",
  "startup_timeout": "10s",
  "shutdown_timeout": "10s",
  "resources": {
    "identity": {"max_conns": 4, "max_operations": 16},
    "audit": {"max_conns": 4, "max_operations": 16},
    "media": {"max_conns": 4, "max_operations": 4},
    "editorial_max_operations": 4
  },
  "control": {
    "origin": "https://control.rixa.test:8443",
    "database_env": "RIXA_CONTROL_DSN",
    "admin_principal": ""
  },
  "sites": [
    {
      "id": "site-a",
      "origin": "https://a.rixa.test:8443",
      "database_env": "RIXA_SITE_A_DSN",
      "media_root": "/var/lib/rixa/site-a/media",
      "public_root": "/var/lib/rixa/site-a/public",
      "public_policy": {
        "indexing": "allow",
        "snippet": "allow",
        "crawlers": [
          {"user_agent": "*", "access": "allow", "purpose": "search"}
        ]
      },
      "admin_principal": ""
    },
    {
      "id": "site-b",
      "origin": "https://b.rixa.test:8443",
      "database_env": "RIXA_SITE_B_DSN",
      "media_root": "/var/lib/rixa/site-b/media",
      "public_root": "/var/lib/rixa/site-b/public",
      "public_policy": {
        "indexing": "noindex",
        "snippet": "none",
        "crawlers": [
          {"user_agent": "*", "access": "disallow", "purpose": "search"}
        ]
      },
      "admin_principal": ""
    }
  ]
}

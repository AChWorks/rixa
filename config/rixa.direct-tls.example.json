{
  "hosting_profile": "direct_tls",
  "listen": "0.0.0.0:443",
  "tls": {
    "cert_file": "/etc/rixa/tls/fullchain.pem",
    "key_file": "/etc/rixa/tls/privkey.pem"
  },
  "language": "en",
  "startup_timeout": "10s",
  "shutdown_timeout": "10s",
  "resources": {
    "identity": {"max_conns": 4, "max_operations": 16},
    "audit": {"max_conns": 4, "max_operations": 16},
    "media": {"max_conns": 4, "max_operations": 4},
    "editorial_max_operations": 4
  },
  "control": {
    "origin": "https://control.example.com",
    "database_env": "RIXA_CONTROL_DSN",
    "admin_principal": ""
  },
  "sites": [
    {
      "id": "site-a",
      "origin": "https://www.example.com",
      "database_env": "RIXA_SITE_A_DSN",
      "media_root": "/var/lib/rixa/site-a/media",
      "public_root": "/var/lib/rixa/site-a/public",
      "public_policy": {
        "indexing": "allow",
        "snippet": "allow",
        "crawlers": [
          {"user_agent": "*", "access": "allow", "purpose": "search"}
        ]
      },
      "admin_principal": ""
    }
  ]
}
